{% extends 'base.html.twig' %}

{% block title %}Sites_Scores Audit #{{ audit.id }} - WatchLeaks{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Audit #{{ audit.id }}</h3>
        <small class="text-muted">Créé le {{ audit.createdAt|date('Y-m-d H:i:s') }}{% if isAdmin and audit.owner %} · {{ audit.owner.email }}{% endif %}</small>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_sites_scores_index') }}" class="btn btn-secondary">Back</a>
        <form method="post" action="{{ path('app_sites_scores_delete', {id: audit.id}) }}" onsubmit="return confirm('Delete this audit?')">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ audit.id) }}">
            <button class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i> Delete</button>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card p-3 h-100">
            <small class="text-muted">Score moyen</small>
            <div class="fs-3 fw-bold {{ audit.score is not null and audit.score < 50 ? 'text-danger' : '' }}">{{ audit.score is not null ? audit.score ~ '/100' : 'N/A' }}</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 h-100">
            <small class="text-muted">Grade</small>
            <div class="fs-3 fw-bold">{{ audit.grade ?: 'N/A' }}</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3 h-100">
            <small class="text-muted">Cibles</small>
            <div class="small">{{ audit.targetList|join(', ') }}</div>
        </div>
    </div>
</div>

{% if audit.error %}
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>{{ audit.error }}</div>
{% endif %}

<div class="card p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="fw-bold mb-0">Prompt enregistré</h6>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="navigator.clipboard.writeText(document.getElementById('audit-prompt').value)">
            <i class="bi bi-clipboard me-1"></i> Copier
        </button>
    </div>
    <textarea id="audit-prompt" class="form-control" rows="9" readonly>{{ audit.prompt }}</textarea>
</div>

<div class="card p-4 mb-4 bg-dark text-success">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="fw-bold mb-0 text-success">Suivi et résultat de la vérification</h6>
        <div class="d-flex align-items-center gap-2">
            {% if audit.score is not null and audit.score < 50 %}<span class="badge bg-danger">Score faible : {{ audit.score }}/100</span>{% endif %}
            {% if audit.finishedAt %}<span class="small opacity-75">Terminé le {{ audit.finishedAt|date('d/m/Y H:i:s') }}</span>{% endif %}
        </div>
    </div>
    <pre class="bg-black text-success p-3 rounded small mb-0" style="white-space: pre-wrap;">{{ audit.executionLog ?: 'Aucun suivi enregistré pour cet audit.' }}</pre>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>URL</th>
                    <th>Final URL</th>
                    <th>Statut</th>
                    <th>Score</th>
                    <th>Grade</th>
                    <th>Erreur</th>
                </tr>
            </thead>
            <tbody>
                {% for result in report %}
                <tr>
                    <td class="small"><code>{{ result.url ?? '-' }}</code></td>
                    <td class="small">{{ result.final_url ?: '-' }}</td>
                    <td>{{ result.status_code ?? '-' }}</td>
                    <td class="{{ result.score is defined and result.score is not null and result.score < 50 ? 'text-danger fw-bold' : '' }}">{{ result.score is defined and result.score is not null ? result.score ~ '/100' : 'N/A' }}</td>
                    <td>{{ result.grade ?? 'N/A' }}</td>
                    <td class="small text-danger">{{ result.error ?? '' }}</td>
                </tr>
                {% else %}
                <tr><td colspan="6" class="text-center text-muted py-4">Aucun rapport détaillé disponible.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
